@page
@model Practical_4.Pages.Ticket.ViewModel
@{
    ViewData["Title"] = Model.IsTicketFound ? $"Event Ticket - {Model.Ticket?.PassId}" : "Ticket Not Found";
}

<div class="container py-4">
    @if (!Model.IsTicketFound || Model.Ticket == null)
    {
        <!-- ERROR PAGE FOR INVALID TICKET ID -->
        <div class="row justify-content-center py-5">
            <div class="col-md-6 col-lg-5 text-center">
                <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
                    <div class="text-danger mb-3" style="font-size: 3.5rem;">
                        <i class="bi bi-exclamation-octagon-fill"></i>
                    </div>
                    <h3 class="fw-bold text-heading mb-2">Invalid or Expired Ticket Pass</h3>
                    <p class="text-muted fs-7 mb-4">
                        The ticket ID provided could not be verified in the university database. It may have expired or contains an incorrect reference.
                    </p>
                    <a href="/" class="btn btn-primary btn-lg rounded-pill fw-bold w-100">
                        <i class="bi bi-house-door-fill me-2"></i> Go to Registration Portal
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- MOBILE-FRIENDLY DIGITAL TICKET VIEW -->
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">

                <!-- Ticket Status Badge & Expiry Indicator -->
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 px-2">
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill font-heading fw-bold">
                        <i class="bi bi-shield-check me-1"></i> VERIFIED &amp; ACTIVE TICKET
                    </span>
                    <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 px-3 py-2 rounded-pill font-monospace fs-7">
                        <i class="bi bi-clock-history me-1"></i> Active until Oct 26, 2026
                    </span>
                </div>

                <div class="event-ticket-card shadow-lg mb-4">
                    <!-- Header Banner -->
                    <div class="@(Model.Ticket.EventType == "Technical" ? "ticket-header-tech" : "ticket-header-nontech") p-4">
                        <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="bg-white text-primary p-2 rounded-3 shadow-sm d-inline-flex"><i class="bi bi-sparkles fs-5"></i></span>
                                <div>
                                    <h6 class="text-uppercase tracking-wider opacity-90 mb-0 fs-7 fw-bold">MARWADI UNIVERSITY</h6>
                                    <h4 class="fw-bold mb-0 text-white font-heading">CampusFest 2026</h4>
                                </div>
                            </div>
                            <span class="badge bg-white text-dark ticket-font-mono px-3 py-2 fw-bold shadow-sm">
                                @Model.Ticket.PassId
                            </span>
                        </div>
                        <h2 class="fw-extrabold text-white mb-1 font-heading">@Model.Ticket.EventName</h2>
                        <span class="badge bg-white bg-opacity-20 text-white border border-white border-opacity-25 px-3 py-1 rounded-pill">
                            @Model.Ticket.EventType Track
                        </span>
                    </div>

                    <!-- Body -->
                    <div class="p-4 p-md-5">
                        <div class="row g-4 align-items-center">
                            <!-- Student Particulars -->
                            <div class="col-md-7">
                                <div class="d-flex align-items-center gap-3 mb-4">
                                    <div class="student-photo-placeholder">
                                        <i class="bi bi-person"></i>
                                    </div>
                                    <div>
                                        <h4 class="fw-bold text-heading mb-1 font-heading">@Model.Ticket.FullName</h4>
                                        <span class="badge bg-light text-dark border font-monospace">
                                            Roll: @Model.Ticket.StudentId
                                        </span>
                                    </div>
                                </div>

                                <div class="row g-3">
                                    <div class="col-6">
                                        <span class="d-block text-muted fs-7">Enrollment Number</span>
                                        <strong class="text-heading font-monospace fs-7">@Model.Ticket.EnrollmentNumber</strong>
                                    </div>
                                    <div class="col-6">
                                        <span class="d-block text-muted fs-7">Class &amp; Division</span>
                                        <strong class="text-heading fs-7">@Model.Ticket.Class (@Model.Ticket.Division)</strong>
                                    </div>
                                    <div class="col-6">
                                        <span class="d-block text-muted fs-7">Department</span>
                                        <strong class="text-heading fs-7">@Model.Ticket.Department</strong>
                                    </div>
                                    <div class="col-6">
                                        <span class="d-block text-muted fs-7">Phone Number</span>
                                        <strong class="text-heading fs-7">@Model.Ticket.PhoneNumber</strong>
                                    </div>
                                    <div class="col-6">
                                        <span class="d-block text-muted fs-7">Event Date</span>
                                        <strong class="text-heading fs-7">October 24 - 26, 2026</strong>
                                    </div>
                                    <div class="col-6">
                                        <span class="d-block text-muted fs-7">Venue</span>
                                        <strong class="text-heading fs-7">@Model.Ticket.Venue</strong>
                                    </div>
                                    <div class="col-6">
                                        <span class="d-block text-muted fs-7">Pass Fee Amount</span>
                                        <span class="text-success fw-bold fs-6">₹@Model.Ticket.FeeAmount.ToString("N2")</span>
                                    </div>
                                    <div class="col-6">
                                        <span class="d-block text-muted fs-7">Registration Status</span>
                                        <span class="badge bg-success bg-opacity-10 text-success">@Model.Ticket.RegistrationStatus</span>
                                    </div>
                                </div>
                            </div>

                            <!-- QR Code & Barcode Display Section -->
                            <div class="col-md-5 text-center border-start border-slate-200 ps-md-4">
                                <div class="bg-white p-3 rounded-4 border shadow-sm d-inline-block mb-3">
                                    <img src="@Model.Ticket.QrCodeBase64" alt="Dynamic Ticket QR Code" class="img-fluid rounded-3" style="max-width: 170px;" />
                                </div>
                                <div class="d-block text-muted ticket-font-mono fs-8 mb-2">SCAN TO VERIFY PASS</div>
                                <div class="ticket-barcode text-center w-100 fs-7 mb-3">
                                    |||| | |||||| || | |||| ||
                                </div>
                            </div>
                        </div>

                        <!-- Buttons: Print & Download -->
                        <div class="d-flex flex-column flex-sm-row justify-content-center align-items-center gap-3 mt-4 pt-4 border-top">
                            <button onclick="window.print()" class="btn btn-outline-dark rounded-pill px-4 font-heading fw-bold">
                                <i class="bi bi-printer me-2"></i> Print Ticket Pass
                            </button>
                            <a href="@Model.Ticket.QrCodeBase64" download="CampusFest2026-Ticket-@(Model.Ticket.PassId).png" class="btn btn-primary rounded-pill px-4 font-heading fw-bold">
                                <i class="bi bi-download me-2"></i> Download QR Code
                            </a>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="bg-light p-3 text-center border-top">
                        <small class="text-muted">
                            Powered by <strong>Marwadi University</strong> • Terms and conditions apply. Carry valid Student ID card.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
