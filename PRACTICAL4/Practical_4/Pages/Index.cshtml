@page
@model IndexModel
@{
    ViewData["Title"] = "CampusFest 2026 - Event Registration Portal";
}

<div class="container py-2">

    <!-- HERO SECTION -->
    <div class="text-center hero-compact">
        <div class="hero-badge mb-2">
            <i class="bi bi-award-fill text-primary"></i> MARWADI UNIVERSITY PRESENTS
        </div>
        <h1 class="hero-title mb-2">
            CampusFest 2026
        </h1>
        <p class="hero-subtitle mb-2">
            Annual university portal for tech & cultural event registration.
        </p>

        <!-- Progress Bar -->
        <div class="mx-auto" style="max-width: 360px;">
            <div class="d-flex justify-content-between text-muted fs-7 mb-1 font-heading fw-semibold">
                <span>Registration Status</span>
                <span>@(Model.IsRegistered ? "100% Confirmed 🎉" : "Step 1 of 4")</span>
            </div>
            <div class="fest-progress-bar-wrap">
                <div class="fest-progress-bar-fill" style="width: @(Model.IsRegistered ? "100%" : "25%");"></div>
            </div>
        </div>
    </div>

    @if (Model.IsRegistered)
    {
        <!-- REGISTRATION CONFIRMATION SECTION (DIGITAL EVENT PASS) -->
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="alert alert-success d-flex align-items-center gap-3 p-3 rounded-4 shadow-sm mb-4 border-0 bg-success bg-opacity-10 text-success">
                    <i class="bi bi-check-circle-fill fs-3 text-success"></i>
                    <div>
                        <h6 class="fw-bold mb-0">Registration Confirmed Successfully!</h6>
                        <small class="text-muted">Your dynamic QR digital event pass is generated. Pass ID: <strong>@Model.RegistrationId</strong></small>
                    </div>
                </div>

                <div class="event-ticket-card mb-4">
                    <div class="@(Model.Registration.EventType == "Technical" ? "ticket-header-tech" : "ticket-header-nontech") d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="student-photo-placeholder">
                                <i class="bi bi-person-bounding-box"></i>
                            </div>
                            <div>
                                <span class="badge bg-white text-dark fw-bold mb-1"><i class="bi bi-ticket-perforated-fill me-1"></i> OFFICIAL DIGITAL EVENT PASS</span>
                                <h3 class="fw-bold mb-0 text-white font-heading">@Model.SelectedSubEventName</h3>
                                <small class="opacity-90">@Model.Registration.EventType Category Track • Oct 24-26, 2026</small>
                            </div>
                        </div>
                        <div class="text-center text-sm-end">
                            <span class="d-block text-uppercase fs-7 opacity-75 font-monospace">PASS ID</span>
                            <span class="badge bg-white text-dark fs-6 font-monospace px-3 py-2 fw-bold shadow-sm">@Model.RegistrationId</span>
                        </div>
                    </div>

                    <div class="p-4 p-md-5">
                        <div class="row g-4">
                            <div class="col-md-8">
                                <h5 class="form-section-title pb-2 border-bottom">
                                    <i class="bi bi-person-badge me-2"></i>Participant Particulars
                                </h5>
                                <div class="row g-3">
                                    <div class="col-sm-6">
                                        <span class="d-block text-muted fs-7">Student Full Name</span>
                                        <strong class="text-heading fs-6">@Model.Registration.FullName</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="d-block text-muted fs-7">Enrollment Number</span>
                                        <strong class="text-heading fs-6 font-monospace">@Model.Registration.EnrollmentNumber</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="d-block text-muted fs-7">Roll Number</span>
                                        <strong class="text-heading fs-6">@Model.Registration.StudentId</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="d-block text-muted fs-7">Class & Division</span>
                                        <strong class="text-heading fs-6">@Model.Registration.Class (@Model.Registration.Division)</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="d-block text-muted fs-7">Department</span>
                                        <strong class="text-heading fs-6">@Model.Registration.Department</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="d-block text-muted fs-7">College Name</span>
                                        <strong class="text-heading fs-6">@Model.Registration.CollegeName</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="d-block text-muted fs-7">Email Address</span>
                                        <strong class="text-heading fs-6">@Model.Registration.Email</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="d-block text-muted fs-7">Phone Number</span>
                                        <strong class="text-heading fs-6">@Model.Registration.PhoneNumber</strong>
                                    </div>
                                </div>

                                <h5 class="form-section-title mt-4 pb-2 border-bottom">
                                    <i class="bi bi-geo-alt me-2"></i>Event Logistics & Venue
                                </h5>
                                <div class="row g-3">
                                    <div class="col-sm-6">
                                        <span class="d-block text-muted fs-7">Event Date</span>
                                        <strong class="text-heading fs-6">October 24 - 26, 2026</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="d-block text-muted fs-7">Event Venue</span>
                                        <strong class="text-heading fs-6">@Model.VenueLocation</strong>
                                    </div>
                                    @if (Model.Registration.EventType == "Technical")
                                    {
                                        <div class="col-sm-6">
                                            <span class="d-block text-muted fs-7">Tech Stack</span>
                                            <span class="badge bg-primary bg-opacity-10 text-primary">@(string.IsNullOrEmpty(Model.Registration.TechStack) ? "General" : Model.Registration.TechStack)</span>
                                        </div>
                                        <div class="col-sm-6">
                                            <span class="d-block text-muted fs-7">Team Size</span>
                                            <span class="text-heading fw-bold">@Model.Registration.TeamSize Member(s)</span>
                                        </div>
                                        if (!string.IsNullOrEmpty(Model.Registration.GithubProfile))
                                        {
                                            <div class="col-12">
                                                <span class="d-block text-muted fs-7">GitHub Profile</span>
                                                <a href="@Model.Registration.GithubProfile" target="_blank" class="text-primary">@Model.Registration.GithubProfile</a>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="col-sm-6">
                                            <span class="d-block text-muted fs-7">Squad Name</span>
                                            <span class="badge bg-purple text-white" style="background-color: #8b5cf6;">@(string.IsNullOrEmpty(Model.Registration.SquadName) ? "Solo Participant" : Model.Registration.SquadName)</span>
                                        </div>
                                        <div class="col-sm-6">
                                            <span class="d-block text-muted fs-7">Equipment Needed</span>
                                            <span class="text-heading fw-bold">@(string.IsNullOrEmpty(Model.Registration.EquipmentNeeded) ? "None" : Model.Registration.EquipmentNeeded)</span>
                                        </div>
                                    }
                                    <div class="col-sm-6">
                                        <span class="d-block text-muted fs-7">Kit T-Shirt Size</span>
                                        <span class="badge bg-secondary">Size: @Model.Registration.TShirtSize</span>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="d-block text-muted fs-7">Pass Fee Amount</span>
                                        <span class="text-success fw-bold fs-5">₹@Model.RegistrationFee.ToString("N2")</span>
                                    </div>
                                </div>
                            </div>

                            <!-- DYNAMIC QR CODE DISPLAY SECTION -->
                            <div class="col-md-4 d-flex flex-column align-items-center justify-content-center text-center border-start border-slate-200 ps-md-4">
                                <div class="bg-white p-3 rounded-4 border mb-3 shadow-sm d-inline-block">
                                    <img src="@Model.GeneratedTicket?.QrCodeBase64" alt="Dynamic Event Ticket QR Code" class="img-fluid rounded-3" style="max-width: 170px;" />
                                </div>
                                <a href="/Ticket/View?id=@Model.RegistrationId" target="_blank" class="d-block text-primary font-monospace fs-7 mb-2 text-decoration-none fw-semibold">
                                    <i class="bi bi-box-arrow-up-right me-1"></i> Open Ticket Link
                                </a>
                                <div class="ticket-barcode text-center w-100 fs-7 mb-3">
                                    |||| | |||||| || | |||| ||
                                </div>
                                <div class="d-grid gap-2 w-100">
                                    <button onclick="window.print()" class="btn btn-reset-secondary btn-sm rounded-pill">
                                        <i class="bi bi-printer me-1"></i> Print Ticket Pass
                                    </button>
                                    <a href="@Model.GeneratedTicket?.QrCodeBase64" download="CampusFest2026-QR-@(Model.RegistrationId).png" class="btn btn-outline-primary btn-sm rounded-pill">
                                        <i class="bi bi-download me-1"></i> Download QR Code
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-4 border-top text-center">
                            <a href="/" class="btn btn-register-primary">
                                <i class="bi bi-arrow-clockwise me-2"></i> Register Another Student
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- REGISTRATION FORM -->
        <div class="row justify-content-center">
            <div class="col-lg-9">

                <!-- VALIDATION SUMMARY CONTAINER -->
                <div asp-validation-summary="All" class="validation-summary-errors" role="alert">
                    <strong>⚠ Please correct the following errors:</strong>
                </div>

                <form method="post" id="campusFestForm" novalidate>

                    <!-- SECTION 1: STUDENT INFORMATION CONTAINER -->
                    <div class="form-section-card">
                        <div class="form-section-title">
                            <span class="fest-step-badge">1</span> Student Information
                        </div>

                        <!-- Full Name -->
                        <div class="form-group-wrap">
                            <label asp-for="Registration.FullName" class="fest-form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input asp-for="Registration.FullName" class="form-control" placeholder="Enter your full name" />
                            </div>
                            <span asp-validation-for="Registration.FullName" class="field-validation-error"></span>
                        </div>

                        <!-- Enrollment Number & Student ID -->
                        <div class="row g-3 form-group-wrap">
                            <div class="col-md-6">
                                <label asp-for="Registration.EnrollmentNumber" class="fest-form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                                    <input asp-for="Registration.EnrollmentNumber" class="form-control text-uppercase" placeholder="Enrollment Number (e.g. 210120110045)" />
                                </div>
                                <span asp-validation-for="Registration.EnrollmentNumber" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Registration.StudentId" class="fest-form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-hash"></i></span>
                                    <input asp-for="Registration.StudentId" class="form-control" placeholder="Roll Number (e.g., 23045)" />
                                </div>
                                <span asp-validation-for="Registration.StudentId" class="field-validation-error"></span>
                            </div>
                        </div>

                        <!-- Class, Division & Department -->
                        <div class="row g-3 form-group-wrap">
                            <div class="col-md-4">
                                <label asp-for="Registration.Class" class="fest-form-label"></label>
                                <select asp-for="Registration.Class" class="form-select">
                                    <option value="">-- Select Class --</option>
                                    <option value="1st Year (Sem 1-2)">1st Year (Sem 1-2)</option>
                                    <option value="2nd Year (Sem 3-4)">2nd Year (Sem 3-4)</option>
                                    <option value="3rd Year (Sem 5-6)">3rd Year (Sem 5-6)</option>
                                    <option value="4th Year (Sem 7-8)">4th Year (Sem 7-8)</option>
                                    <option value="Post Graduate (M.Tech/MCA)">Post Graduate (M.Tech/MCA)</option>
                                </select>
                                <span asp-validation-for="Registration.Class" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Registration.Division" class="fest-form-label"></label>
                                <select asp-for="Registration.Division" class="form-select">
                                    <option value="">-- Select Division --</option>
                                    <option value="Division A">Division A</option>
                                    <option value="Division B">Division B</option>
                                    <option value="Division C">Division C</option>
                                    <option value="Division D">Division D</option>
                                </select>
                                <span asp-validation-for="Registration.Division" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Registration.Department" class="fest-form-label"></label>
                                <select asp-for="Registration.Department" class="form-select">
                                    <option value="">-- Select Department --</option>
                                    <option value="Computer Engineering">Computer Engineering</option>
                                    <option value="Information Technology">Information Technology</option>
                                    <option value="Artificial Intelligence & ML">Artificial Intelligence & ML</option>
                                    <option value="Electronics & Communication">Electronics & Communication</option>
                                    <option value="Mechanical Engineering">Mechanical Engineering</option>
                                    <option value="Civil Engineering">Civil Engineering</option>
                                    <option value="Management (BBA/MBA)">Management (BBA/MBA)</option>
                                </select>
                                <span asp-validation-for="Registration.Department" class="field-validation-error"></span>
                            </div>
                        </div>

                        <!-- College Name -->
                        <div class="form-group-wrap">
                            <label asp-for="Registration.CollegeName" class="fest-form-label"></label>
                            <input asp-for="Registration.CollegeName" class="form-control" placeholder="College Name" />
                            <span asp-validation-for="Registration.CollegeName" class="field-validation-error"></span>
                        </div>

                        <!-- Email & Confirm Email -->
                        <div class="row g-3 form-group-wrap">
                            <div class="col-md-6">
                                <label asp-for="Registration.Email" class="fest-form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Registration.Email" class="form-control" placeholder="name@example.com" />
                                </div>
                                <span asp-validation-for="Registration.Email" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Registration.ConfirmEmail" class="fest-form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-envelope-check"></i></span>
                                    <input asp-for="Registration.ConfirmEmail" class="form-control" placeholder="Confirm email address" />
                                </div>
                                <span asp-validation-for="Registration.ConfirmEmail" class="field-validation-error"></span>
                            </div>
                        </div>

                        <!-- Phone Number -->
                        <div class="form-group-wrap">
                            <label asp-for="Registration.PhoneNumber" class="fest-form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Registration.PhoneNumber" class="form-control" placeholder="10-digit mobile number" />
                            </div>
                            <span asp-validation-for="Registration.PhoneNumber" class="field-validation-error"></span>
                        </div>
                    </div>

                    <!-- SECTION 2: EVENT SELECTION CARDS -->
                    <div class="form-section-card">
                        <div class="form-section-title">
                            <span class="fest-step-badge">2</span> Event Selection
                        </div>

                        <div class="row g-3">
                            <!-- Technical Card -->
                            <div class="col-md-6">
                                <div class="track-option-card @(Model.Registration.EventType == "Technical" ? "tech-selected" : "")" id="cardTech" onclick="selectTrack('Technical')">
                                    <input type="radio" asp-for="Registration.EventType" value="Technical" class="track-radio" id="radioTech" />
                                    <div class="track-icon tech-icon">
                                        ⚡
                                    </div>
                                    <h5 class="fw-bold text-heading mb-1 font-heading">Technical Events ⚡</h5>
                                    <p class="text-muted fs-7 mb-0">Hackathons, Coding Competitions, Web Challenges, Robotics & UI/UX Design.</p>
                                </div>
                            </div>

                            <!-- Non-Technical Card -->
                            <div class="col-md-6">
                                <div class="track-option-card @(Model.Registration.EventType == "Non-Technical" ? "nontech-selected" : "")" id="cardNonTech" onclick="selectTrack('Non-Technical')">
                                    <input type="radio" asp-for="Registration.EventType" value="Non-Technical" class="track-radio" id="radioNonTech" />
                                    <div class="track-icon nontech-icon">
                                        🎭
                                    </div>
                                    <h5 class="fw-bold text-heading mb-1 font-heading">Non-Technical Events 🎭</h5>
                                    <p class="text-muted fs-7 mb-0">Dance, Singing, Photography, Drama, & Campus Quiz Competitions.</p>
                                </div>
                            </div>
                        </div>
                        <span asp-validation-for="Registration.EventType" class="field-validation-error"></span>
                    </div>

                    <!-- SECTION 3: CATEGORY DETAILS SECTION -->
                    <div class="form-section-card">
                        <div class="form-section-title">
                            <span class="fest-step-badge">3</span> Category Details
                        </div>

                        <!-- TECHNICAL EVENT CATEGORY -->
                        <div id="techFieldsBox" class="stream-box tech-box @(Model.Registration.EventType == "Technical" ? "" : "d-none")">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-code-slash text-primary fs-5"></i>
                                <h6 class="fw-bold text-heading mb-0 font-heading">Technical Event Details</h6>
                            </div>

                            <div class="form-group-wrap">
                                <label asp-for="Registration.TechnicalEvent" class="fest-form-label"></label>
                                <select asp-for="Registration.TechnicalEvent" class="form-select">
                                    <option value="">-- Select Technical Event --</option>
                                    <option value="Hackathon">Hackathon - ₹350</option>
                                    <option value="Coding Competition">Coding Competition - ₹250</option>
                                    <option value="Web Development Challenge">Web Development Challenge - ₹300</option>
                                    <option value="Robotics Competition">Robotics Competition - ₹400</option>
                                    <option value="UI/UX Design Competition">UI/UX Design Competition - ₹250</option>
                                </select>
                                <span asp-validation-for="Registration.TechnicalEvent" class="field-validation-error"></span>
                            </div>

                            <div class="row g-3 form-group-wrap">
                                <div class="col-md-6">
                                    <label asp-for="Registration.TechStack" class="fest-form-label"></label>
                                    <input asp-for="Registration.TechStack" class="form-control" placeholder="e.g., C#, Python, React (2-200 chars)" />
                                    <span asp-validation-for="Registration.TechStack" class="field-validation-error"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Registration.TeamSize" class="fest-form-label"></label>
                                    <input asp-for="Registration.TeamSize" class="form-control" type="number" min="1" max="10" />
                                    <span asp-validation-for="Registration.TeamSize" class="field-validation-error"></span>
                                </div>
                            </div>

                            <div class="mb-2">
                                <label asp-for="Registration.GithubProfile" class="fest-form-label"></label>
                                <input asp-for="Registration.GithubProfile" class="form-control" placeholder="https://github.com/username (Optional)" />
                                <span asp-validation-for="Registration.GithubProfile" class="field-validation-error"></span>
                            </div>
                        </div>

                        <!-- NON-TECHNICAL EVENT CATEGORY -->
                        <div id="nonTechFieldsBox" class="stream-box nontech-box @(Model.Registration.EventType == "Non-Technical" ? "" : "d-none")">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-music-note-beamed text-purple fs-5" style="color: #8b5cf6;"></i>
                                <h6 class="fw-bold text-heading mb-0 font-heading">Non-Technical Event Details</h6>
                            </div>

                            <div class="form-group-wrap">
                                <label asp-for="Registration.NonTechnicalEvent" class="fest-form-label"></label>
                                <select asp-for="Registration.NonTechnicalEvent" class="form-select">
                                    <option value="">-- Select Non-Technical Event --</option>
                                    <option value="Dance Competition">Dance Competition - ₹300</option>
                                    <option value="Singing Competition">Singing Competition - ₹250</option>
                                    <option value="Photography Competition">Photography Competition - ₹200</option>
                                    <option value="Drama Competition">Drama Competition - ₹350</option>
                                    <option value="Quiz Competition">Quiz Competition - ₹150</option>
                                </select>
                                <span asp-validation-for="Registration.NonTechnicalEvent" class="field-validation-error"></span>
                            </div>

                            <div class="row g-3 mb-2">
                                <div class="col-md-6">
                                    <label asp-for="Registration.SquadName" class="fest-form-label"></label>
                                    <input asp-for="Registration.SquadName" class="form-control" placeholder="Squad Name (3-50 chars)" />
                                    <span asp-validation-for="Registration.SquadName" class="field-validation-error"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Registration.EquipmentNeeded" class="fest-form-label"></label>
                                    <input asp-for="Registration.EquipmentNeeded" class="form-control" placeholder="e.g., Acoustic Guitar (Optional, max 500 chars)" />
                                    <span asp-validation-for="Registration.EquipmentNeeded" class="field-validation-error"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 4: LOGISTICS & TERMS CONTAINER -->
                    <div class="form-section-card">
                        <div class="form-section-title">
                            <span class="fest-step-badge">4</span> Logistics & Terms
                        </div>

                        <div class="row g-3 form-group-wrap">
                            <div class="col-md-6">
                                <label asp-for="Registration.TShirtSize" class="fest-form-label"></label>
                                <select asp-for="Registration.TShirtSize" class="form-select">
                                    <option value="">-- Select T-Shirt Size --</option>
                                    <option value="S">Small (S)</option>
                                    <option value="M">Medium (M)</option>
                                    <option value="L">Large (L)</option>
                                    <option value="XL">Extra Large (XL)</option>
                                    <option value="XXL">Double Extra Large (XXL)</option>
                                </select>
                                <span asp-validation-for="Registration.TShirtSize" class="field-validation-error"></span>
                            </div>
                        </div>

                        <!-- TERMS CHECKBOX SECTION -->
                        <div class="terms-checkbox-wrap">
                            <input asp-for="Registration.AgreedToTerms" class="form-check-input mt-0" style="cursor: pointer; min-width: 20px; min-height: 20px;" />
                            <div class="form-check-label text-muted fs-7 mb-0">
                                <label asp-for="Registration.AgreedToTerms" style="cursor: pointer;">I agree to the</label>
                                <button type="button" class="btn btn-link p-0 border-0 text-primary text-decoration-none fw-semibold align-baseline fs-7 mx-1" onclick="alert('CampusFest 2026 Terms & Conditions:\n1. Students must carry valid photo college ID.\n2. Malpractice results in disqualification.\n3. Digital pass required for entry.');">
                                    Terms &amp; Conditions
                                </button>
                                <label asp-for="Registration.AgreedToTerms" style="cursor: pointer;">and University Code of Conduct.</label>
                            </div>
                        </div>
                        <span asp-validation-for="Registration.AgreedToTerms" class="field-validation-error"></span>
                    </div>

                    <!-- BUTTON SECTION -->
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 pt-2">
                        <a href="/" class="btn btn-reset-secondary w-100 w-sm-auto text-center">
                            Reset
                        </a>
                        <button type="submit" class="btn btn-register-primary w-100 w-sm-auto">
                            Register Now 🚀
                        </button>
                    </div>

                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function selectTrack(trackType) {
            const radioTech = document.getElementById('radioTech');
            const radioNonTech = document.getElementById('radioNonTech');
            const cardTech = document.getElementById('cardTech');
            const cardNonTech = document.getElementById('cardNonTech');
            const techBox = document.getElementById('techFieldsBox');
            const nonTechBox = document.getElementById('nonTechFieldsBox');

            if (trackType === 'Technical') {
                radioTech.checked = true;
                cardTech.classList.add('tech-selected');
                cardNonTech.classList.remove('nontech-selected');
                techBox.classList.remove('d-none');
                nonTechBox.classList.add('d-none');
            } else {
                radioNonTech.checked = true;
                cardNonTech.classList.add('nontech-selected');
                cardTech.classList.remove('tech-selected');
                nonTechBox.classList.remove('d-none');
                techBox.classList.add('d-none');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const radioTech = document.getElementById('radioTech');
            if (radioTech && radioTech.checked) {
                selectTrack('Technical');
            } else {
                const radioNonTech = document.getElementById('radioNonTech');
                if (radioNonTech && radioNonTech.checked) {
                    selectTrack('Non-Technical');
                }
            }

            const firstInvalid = document.querySelector('.input-validation-error, .is-invalid');
            if (firstInvalid) {
                firstInvalid.focus();
                firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });
    </script>
}
